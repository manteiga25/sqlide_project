<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10.0" style="-fx-background-color: #2C2C2C;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sqlide.Configuration.AiConfigurationController">
   <children>
      <Label text="AI Configuration" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Provider:" textFill="WHITE" />
            <ComboBox fx:id="ProviderCombo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
            <Label text="API Key:" textFill="WHITE" GridPane.rowIndex="1" />
            <PasswordField fx:id="ApiKeyField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Model Name:" textFill="WHITE" GridPane.rowIndex="2" />
            <ComboBox fx:id="ModelCombo" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Base URL (Ollama/LMStudio):" textFill="WHITE" GridPane.rowIndex="3" />
            <TextField fx:id="BaseUrlField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Google CSE ID (Search):" textFill="WHITE" GridPane.rowIndex="4" />
            <TextField fx:id="GoogleCseIdField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#save" style="-fx-background-color: #3574F0;" text="Save" textFill="WHITE" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
