<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@../../../../css/ContextMenuStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sqlide.Configuration.permissionConfController">

    <!-- Contas -->
    <VBox prefWidth="230.0" HBox.hgrow="NEVER">
        <children>
            <ToolBar fx:id="tool" style="-fx-background-color: #3C3C3C; -fx-border-color: black;">
                <items>
                    <Button mnemonicParsing="false" onAction="#addUser" text="Add" />
                    <Button mnemonicParsing="false" onAction="#delete" text="Delete" />
                </items>
            </ToolBar>
            <ListView fx:id="usersListView" stylesheets="@../../../../css/ListViewStyle.css" VBox.vgrow="ALWAYS" />
        </children>
    </VBox>

    <!-- Detalhe da conta selecionada -->
    <VBox spacing="10.0" style="-fx-background-color: #2c2c2c;" stylesheets="@../../../../css/TitledPaneStyle.css" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
        <children>

            <Label fx:id="noticeLabel" style="-fx-text-fill: #E5C07B; -fx-font-size: 11px;" wrapText="true" />

            <TitledPane fx:id="userInformationPane" collapsible="false" text="Account">
                <content>
                    <GridPane hgap="10.0" stylesheets="@../../../../css/TextFieldModernStyle.css" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="80.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>
                        <children>
                            <Label text="Name:" textFill="WHITE" GridPane.rowIndex="0" />
                            <TextField fx:id="nameField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label fx:id="hostLabel" text="Host:" textFill="WHITE" GridPane.rowIndex="1" />
                            <TextField fx:id="hostField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Password:" textFill="WHITE" GridPane.rowIndex="2" />
                            <HBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <children>
                                    <PasswordField fx:id="passField" promptText="type a new password" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="changePasswordButton" mnemonicParsing="false" onAction="#changePassword" text="Change" />
                                </children>
                            </HBox>
                        </children>
                    </GridPane>
                </content>
            </TitledPane>

            <TitledPane fx:id="globalPrivilegesPane" collapsible="false" maxHeight="1.7976931348623157E308" text="Privileges" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="10.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <children>
                                    <Label text="Scope:" textFill="#f5f5f5" />
                                    <ChoiceBox fx:id="TableBox" maxWidth="1.7976931348623157E308" stylesheets="@../../../../css/ChoiceBoxModern.css" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>

                            <Label style="-fx-text-fill: #9A9A9A; -fx-font-size: 11px;" text="Checked boxes reflect the privileges the account already has in the selected scope." wrapText="true" />

                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                <content>
                                    <FlowPane fx:id="privilegesBox" hgap="18.0" vgap="8.0">
                                        <padding>
                                            <Insets bottom="6.0" left="4.0" right="4.0" top="6.0" />
                                        </padding>
                                    </FlowPane>
                                </content>
                            </ScrollPane>

                            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                <children>
                                    <Label fx:id="statusLabel" style="-fx-text-fill: #9A9A9A; -fx-font-size: 11px;" HBox.hgrow="ALWAYS" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#reloadPermissions" text="Reload" />
                                    <Button fx:id="saveButton" mnemonicParsing="false" onAction="#savePermissions" style="-fx-background-color: #3574F0; -fx-text-fill: white;" text="Save changes" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </content>
            </TitledPane>
        </children>
    </VBox>
</HBox>
