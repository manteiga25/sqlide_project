<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="ContainerSize" style="-fx-background-color: #2C2C2C;" stylesheets="@../../../css/ContextMenuStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sqlide.MS_accessController">

    <children>
        <!-- Header -->
        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <Label alignment="CENTER" text="Create MS Access Database" textAlignment="CENTER" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label text="Configure your database settings" textFill="#E0E0E0">
                <font>
                    <Font name="System" size="14.0" />
                </font>
            </Label>
        </VBox>

        <!-- Main Content Container -->
        <ScrollPane layoutX="20.0" layoutY="100.0" style="-fx-background: transparent; -fx-background-color: transparent;" stylesheets="@../../../css/ScrollHbarStyle.css" VBox.vgrow="ALWAYS">
            <VBox spacing="25.0" style="-fx-padding: 20;">

                <!-- Basic Settings Section -->
                <VBox spacing="15.0" style="-fx-background-color: #333333; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Basic Settings" textFill="WHITE" />

                    <GridPane hgap="20.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="120.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="300.0" />
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="60.0" minWidth="60.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="35.0" vgrow="SOMETIMES" />
                        </rowConstraints>

                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Database Name:" textFill="WHITE" />
                        <JFXTextField fx:id="TextDBName" promptText="Enter database name..." style="-fx-prompt-text-fill: #888888; -fx-text-fill: white; -fx-background-color: #404040; -fx-background-radius: 5;" GridPane.columnIndex="1" />

                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Save Path:" textFill="WHITE" GridPane.rowIndex="1" />
                        <JFXTextField fx:id="SaveDBPath" promptText="Select save location..." style="-fx-prompt-text-fill: #888888; -fx-text-fill: white; -fx-background-color: #404040; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <JFXButton mnemonicParsing="false" onAction="#selectDir" style="-fx-background-color: #3574F0; -fx-background-radius: 5;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <graphic>
                                <FontAwesomeIconView fill="WHITE" glyphName="FOLDER" size="18.0" />
                            </graphic>
                        </JFXButton>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- Action Buttons -->
        <HBox alignment="CENTER_RIGHT" layoutX="20.0" layoutY="510.0" spacing="5.0">
            <JFXButton style="-fx-background-color: transparent; -fx-border-color: #666666; -fx-border-radius: 5; -fx-background-radius: 5;" text="Cancel" textFill="#CCCCCC">
                <font>
                    <Font name="System" size="14.0" />
                </font>
            </JFXButton>
            <JFXButton fx:id="Submit" mnemonicParsing="false" onAction="#createDB" style="-fx-background-color: #3574F0; -fx-background-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 0, 1);" text="Create Database" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </JFXButton>
            <VBox.margin>
                <Insets bottom="5.0" right="5.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
