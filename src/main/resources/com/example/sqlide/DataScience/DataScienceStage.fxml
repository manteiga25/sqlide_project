<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="MainContainer" prefHeight="760.0" prefWidth="1360.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sqlide.DataScience.DataScienceController">

    <stylesheets>
        <URL value="@../../../../css/ds.css" />
        <URL value="@../../../../css/ContextMenuStyle.css" />
    </stylesheets>

    <!-- ===== Cabeçalho ===== -->
    <top>
        <VBox spacing="8.0" styleClass="ds-toolbar">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="ds-title" text="Data Science" />
                        <Label fx:id="lblTable" styleClass="ds-hint" text="no table" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ProgressBar fx:id="globalProgress" prefWidth="140.0" progress="0.0" visible="false" />
                        <Label fx:id="lblStatus" styleClass="ds-hint" text="Ready" />
                        <Button mnemonicParsing="false" onAction="#reloadEverything" text="Refresh" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- ===== Colunas ===== -->
    <left>
        <VBox prefWidth="300.0" spacing="8.0">
            <padding>
                <Insets bottom="12.0" left="12.0" right="6.0" top="12.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label styleClass="ds-section" text="Columns" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#load_table_metadata" text="Reload" />
                    </children>
                </HBox>

                <TextField fx:id="searchField" promptText="Filter columns..." />

                <TableView fx:id="tblColumns" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="110.0" text="Name" />
                        <TableColumn fx:id="colType" prefWidth="80.0" text="Type" />
                        <TableColumn fx:id="colNulls" prefWidth="55.0" text="Nulls" />
                        <TableColumn fx:id="colNullPct" prefWidth="55.0" text="Null %" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label styleClass="ds-section" text="Column profile" />
                <TextArea fx:id="taColumnProfile" editable="false" prefRowCount="9" wrapText="true" />
            </children>
        </VBox>
    </left>

    <!-- ===== Área principal ===== -->
    <center>
        <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE">
            <padding>
                <Insets bottom="12.0" left="6.0" right="6.0" top="12.0" />
            </padding>
            <tabs>

                <!-- Resumo -->
                <Tab text="Overview">
                    <SplitPane dividerPositions="0.62" orientation="HORIZONTAL">
                        <items>
                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label styleClass="ds-section" text="Descriptive statistics" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button mnemonicParsing="false" onAction="#computeQuickStats" styleClass="ds-primary" text="Compute" />
                                            <Button mnemonicParsing="false" onAction="#exportStatistics" text="Export CSV" />
                                        </children>
                                    </HBox>
                                    <Label styleClass="ds-hint" text="Aggregates run on the database server, over the whole table." />
                                    <TableView fx:id="tableStat" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="columnName" prefWidth="110.0" text="Column" />
                                            <TableColumn fx:id="columnCount" prefWidth="70.0" text="Rows" />
                                            <TableColumn fx:id="columnNulls" prefWidth="60.0" text="Nulls" />
                                            <TableColumn fx:id="columnMin" prefWidth="80.0" text="Min" />
                                            <TableColumn fx:id="columnMax" prefWidth="80.0" text="Max" />
                                            <TableColumn fx:id="columnMean" prefWidth="80.0" text="Mean" />
                                            <TableColumn fx:id="columnMedian" prefWidth="80.0" text="Median" />
                                            <TableColumn fx:id="columnSTD" prefWidth="80.0" text="Std dev" />
                                            <TableColumn fx:id="columnVariance" prefWidth="90.0" text="Variance" />
                                            <TableColumn fx:id="columnSkew" prefWidth="75.0" text="Skew" />
                                            <TableColumn fx:id="columnKurtosis" prefWidth="75.0" text="Kurtosis" />
                                        </columns>
                                    </TableView>
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label styleClass="ds-section" text="Correlation" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button mnemonicParsing="false" onAction="#renderCorrelation" text="Compute" />
                                            <Button fx:id="btnExportCorr" mnemonicParsing="false" onAction="#handleExportCorrelationMatrix" text="Export CSV" />
                                        </children>
                                    </HBox>
                                    <Label styleClass="ds-hint" text="Pearson between every pair of numeric columns." />
                                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                                        <content>
                                            <StackPane fx:id="chartCorrelation" styleClass="ds-surface" />
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </items>
                    </SplitPane>
                </Tab>

                <!-- Distribuição -->
                <Tab text="Distribution">
                    <SplitPane dividerPositions="0.32" orientation="HORIZONTAL">
                        <items>
                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <Label styleClass="ds-section" text="Shape of the distribution" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Column:" />
                                            <ChoiceBox fx:id="boxTarget" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                        </children>
                                    </HBox>
                                    <HBox spacing="8.0">
                                        <children>
                                            <Button mnemonicParsing="false" onAction="#calculateDistribution" styleClass="ds-primary" text="Analyse" />
                                            <Button mnemonicParsing="false" onAction="#clearDistributionLog" text="Clear log" />
                                        </children>
                                    </HBox>
                                    <TextArea fx:id="textDistribution" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Histogram:" />
                                            <ChoiceBox fx:id="boxFrequency" />
                                            <Label text="Bins:" />
                                            <Spinner fx:id="binSpinner" editable="true" prefWidth="90.0" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button mnemonicParsing="false" onAction="#cleanGraph" text="Clear chart" />
                                        </children>
                                    </HBox>
                                    <ScrollPane fx:id="graphstack" fitToHeight="true" VBox.vgrow="ALWAYS">
                                        <content>
                                            <BarChart fx:id="chartDistribution" animated="false" barGap="1.0" categoryGap="3.0" legendVisible="false">
                                                <xAxis>
                                                    <CategoryAxis side="BOTTOM" />
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis side="LEFT" />
                                                </yAxis>
                                            </BarChart>
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </items>
                    </SplitPane>
                </Tab>

                <!-- Valores em falta -->
                <Tab text="Missing values">
                    <SplitPane dividerPositions="0.42" orientation="HORIZONTAL">
                        <items>
                            <VBox fx:id="ImputBox" spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <Label styleClass="ds-section" text="Fill missing values" />
                                    <Label styleClass="ds-hint" text="Preview first, then apply. Applying writes an UPDATE to the table." wrapText="true" />

                                    <GridPane hgap="8.0" vgap="6.0">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT" minWidth="70.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints />
                                            <RowConstraints />
                                            <RowConstraints />
                                        </rowConstraints>
                                        <children>
                                            <Label text="Column:" GridPane.rowIndex="0" />
                                            <ChoiceBox fx:id="cbImputeColumn" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                            <Label text="Method:" GridPane.rowIndex="1" />
                                            <ComboBox fx:id="comboImputeMethod" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                            <Label fx:id="lblConstant" text="Value:" GridPane.rowIndex="2" />
                                            <TextField fx:id="tfConstantValue" promptText="value to write" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        </children>
                                    </GridPane>

                                    <TitledPane fx:id="paneImputeAdvanced" animated="false" expanded="true" text="Predictor columns">
                                        <content>
                                            <VBox spacing="6.0">
                                                <children>
                                                    <Label styleClass="ds-hint" text="Used by regression and k-NN to predict the missing values." wrapText="true" />
                                                    <ListView fx:id="lvImputePredictors" prefHeight="130.0" />
                                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                        <children>
                                                            <Label text="k:" />
                                                            <Spinner fx:id="spinK" editable="true" prefWidth="80.0" />
                                                            <Region HBox.hgrow="ALWAYS" />
                                                            <Button mnemonicParsing="false" onAction="#clearPredictorSelection" text="Clear" />
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </VBox>
                                        </content>
                                    </TitledPane>

                                    <HBox spacing="8.0">
                                        <children>
                                            <Button fx:id="btnPreviewImpute" mnemonicParsing="false" onAction="#handlePreviewImputation" styleClass="ds-primary" text="Preview" />
                                            <Button fx:id="btnRunImpute" disable="true" mnemonicParsing="false" onAction="#handleRunImputation" styleClass="ds-danger" text="Apply to database" />
                                            <ProgressIndicator fx:id="piImpute" prefHeight="20.0" prefWidth="20.0" visible="false" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <Label styleClass="ds-section" text="Preview" />
                                    <TextArea fx:id="taModelSummary" editable="false" prefRowCount="6" wrapText="true" />
                                    <Label styleClass="ds-section" text="Rows that would change" />
                                    <TableView fx:id="tblImputePreview" VBox.vgrow="ALWAYS">
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                    <Label styleClass="ds-section" text="Log" />
                                    <TextArea fx:id="taImputeLog" editable="false" prefRowCount="5" wrapText="true" />
                                </children>
                            </VBox>
                        </items>
                    </SplitPane>
                </Tab>

                <!-- Outliers -->
                <Tab text="Outliers">
                    <SplitPane dividerPositions="0.38" orientation="HORIZONTAL">
                        <items>
                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <Label styleClass="ds-section" text="Detect outliers" />

                                    <GridPane hgap="8.0" vgap="6.0">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT" minWidth="80.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints />
                                            <RowConstraints />
                                            <RowConstraints />
                                        </rowConstraints>
                                        <children>
                                            <Label text="Column:" GridPane.rowIndex="0" />
                                            <ChoiceBox fx:id="cbOutlierColumn" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                            <Label text="Method:" GridPane.rowIndex="1" />
                                            <ComboBox fx:id="comboOutlierMethod" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                            <Label fx:id="lblThreshold" text="Threshold:" GridPane.rowIndex="2" />
                                            <TextField fx:id="tfOutlierThresh" promptText="1.5" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        </children>
                                    </GridPane>

                                    <HBox spacing="8.0">
                                        <children>
                                            <Button fx:id="btnDetectOutliers" mnemonicParsing="false" onAction="#handleDetectOutliers" styleClass="ds-primary" text="Detect" />
                                            <Button fx:id="btnClampOutliers" disable="true" mnemonicParsing="false" onAction="#handleClampOutliers" text="Clamp to bounds" />
                                            <Button fx:id="btnRemoveOutliers" disable="true" mnemonicParsing="false" onAction="#handleRemoveOutliers" styleClass="ds-danger" text="Delete rows" />
                                        </children>
                                    </HBox>

                                    <Label styleClass="ds-section" text="Result" />
                                    <TextArea fx:id="taOutlierSummary" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
                                </children>
                            </VBox>

                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <Label styleClass="ds-section" text="Extreme values" />
                                    <TableView fx:id="tblOutliersPreview" prefHeight="220.0">
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                    <Label styleClass="ds-section" text="Where the bounds fall" />
                                    <ScrollPane fitToHeight="true" VBox.vgrow="ALWAYS">
                                        <content>
                                            <BarChart fx:id="chartOutlierSpread" animated="false" legendVisible="false">
                                                <xAxis>
                                                    <CategoryAxis side="BOTTOM" />
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis side="LEFT" />
                                                </yAxis>
                                            </BarChart>
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </items>
                    </SplitPane>
                </Tab>

                <!-- Previsão de séries -->
                <Tab text="Forecast">
                    <SplitPane dividerPositions="0.34" orientation="HORIZONTAL">
                        <items>
                            <ScrollPane fitToWidth="true">
                                <content>
                                    <VBox spacing="8.0">
                                        <padding>
                                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                        </padding>
                                        <children>
                                            <Label styleClass="ds-section" text="Forecast a series" />
                                            <Label styleClass="ds-hint" text="The values are read in the order of the column you pick, which is what makes them a series." wrapText="true" />

                                            <GridPane hgap="8.0" vgap="6.0">
                                                <columnConstraints>
                                                    <ColumnConstraints halignment="RIGHT" minWidth="105.0" />
                                                    <ColumnConstraints hgrow="ALWAYS" />
                                                </columnConstraints>
                                                <rowConstraints>
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                </rowConstraints>
                                                <children>
                                                    <Label text="Values:" GridPane.rowIndex="0" />
                                                    <ChoiceBox fx:id="cbForecastValue" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                    <Label text="Order by:" GridPane.rowIndex="1" />
                                                    <ChoiceBox fx:id="cbForecastOrder" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                    <Label text="Method:" GridPane.rowIndex="2" />
                                                    <ComboBox fx:id="comboForecastMethod" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                </children>
                                            </GridPane>

                                            <Label fx:id="lblForecastHint" styleClass="ds-hint" wrapText="true" />

                                            <GridPane hgap="8.0" vgap="6.0">
                                                <columnConstraints>
                                                    <ColumnConstraints halignment="RIGHT" minWidth="105.0" />
                                                    <ColumnConstraints hgrow="ALWAYS" />
                                                </columnConstraints>
                                                <rowConstraints>
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                </rowConstraints>
                                                <children>
                                                    <Label text="Horizon:" GridPane.rowIndex="0" />
                                                    <Spinner fx:id="horizonSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                    <Label text="Differencing:" GridPane.rowIndex="1" />
                                                    <Spinner fx:id="diffSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                    <Label text="Order p:" GridPane.rowIndex="2" />
                                                    <Spinner fx:id="orderPSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                    <Label text="Order q:" GridPane.rowIndex="3" />
                                                    <Spinner fx:id="orderQSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                                    <Label text="Season length:" GridPane.rowIndex="4" />
                                                    <Spinner fx:id="seasonSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                                    <Label text="Alpha:" GridPane.rowIndex="5" />
                                                    <Spinner fx:id="alphaSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                                    <Label text="Beta:" GridPane.rowIndex="6" />
                                                    <Spinner fx:id="betaSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                                                    <Label text="Gamma:" GridPane.rowIndex="7" />
                                                    <Spinner fx:id="gammaSpinner" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                                </children>
                                            </GridPane>

                                            <HBox spacing="8.0">
                                                <children>
                                                    <Button mnemonicParsing="false" onAction="#runForecast" styleClass="ds-primary" text="Forecast" />
                                                    <Button mnemonicParsing="false" onAction="#clearForecast" text="Clear" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                </content>
                            </ScrollPane>

                            <VBox spacing="8.0">
                                <padding>
                                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                </padding>
                                <children>
                                    <LineChart fx:id="chartForecast" animated="false" createSymbols="false" VBox.vgrow="ALWAYS">
                                        <xAxis>
                                            <NumberAxis label="Step" side="BOTTOM" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis label="Value" side="LEFT" />
                                        </yAxis>
                                    </LineChart>
                                    <Label styleClass="ds-section" text="Results" />
                                    <TextArea fx:id="taForecastResults" editable="false" prefRowCount="10" wrapText="true" />
                                </children>
                            </VBox>
                        </items>
                    </SplitPane>
                </Tab>

                <!-- Modelação -->
                <Tab text="Modeling">
                    <SplitPane dividerPositions="0.36" orientation="HORIZONTAL">
                        <items>
                            <ScrollPane fitToWidth="true">
                                <content>
                                    <VBox fx:id="boxModel" spacing="8.0">
                                        <padding>
                                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                        </padding>
                                        <children>
                                            <Label styleClass="ds-section" text="Train a model" />

                                            <GridPane hgap="8.0" vgap="6.0">
                                                <columnConstraints>
                                                    <ColumnConstraints halignment="RIGHT" minWidth="95.0" />
                                                    <ColumnConstraints hgrow="ALWAYS" />
                                                </columnConstraints>
                                                <rowConstraints>
                                                    <RowConstraints />
                                                    <RowConstraints />
                                                </rowConstraints>
                                                <children>
                                                    <Label text="Target:" GridPane.rowIndex="0" />
                                                    <ChoiceBox fx:id="cbTargetColumn" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                    <Label text="Algorithm:" GridPane.rowIndex="1" />
                                                    <ComboBox fx:id="comboModelAlgo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                </children>
                                            </GridPane>

                                            <Label styleClass="ds-section" text="Feature columns" />
                                            <ListView fx:id="lvFeatures" prefHeight="150.0" />

                                            <Label styleClass="ds-section" text="Preprocessing" />
                                            <Label styleClass="ds-hint" text="Fitted once on the training rows, then applied to the test set and to every prediction." wrapText="true" />
                                            <ListView fx:id="lvPreprocessing" prefHeight="120.0" />

                                            <TitledPane animated="false" expanded="false" text="Training options">
                                                <content>
                                                    <GridPane hgap="8.0" vgap="6.0">
                                                        <columnConstraints>
                                                            <ColumnConstraints halignment="RIGHT" minWidth="110.0" />
                                                            <ColumnConstraints hgrow="ALWAYS" />
                                                        </columnConstraints>
                                                        <rowConstraints>
                                                            <RowConstraints />
                                                            <RowConstraints />
                                                            <RowConstraints />
                                                            <RowConstraints />
                                                            <RowConstraints />
                                                        </rowConstraints>
                                                        <children>
                                                            <Label text="Test split (%):" GridPane.rowIndex="0" />
                                                            <Spinner fx:id="testSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                            <Label text="Learning rate:" GridPane.rowIndex="1" />
                                                            <Spinner fx:id="learningRateSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                            <Label text="Batch (rows):" GridPane.rowIndex="2" />
                                                            <Spinner fx:id="batchSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                            <Label text="Row limit:" GridPane.rowIndex="3" />
                                                            <Spinner fx:id="limitSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                                            <Label text="Start offset:" GridPane.rowIndex="4" />
                                                            <Spinner fx:id="offsetSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                        </children>
                                                    </GridPane>
                                                </content>
                                            </TitledPane>

                                            <HBox fx:id="boxStart" spacing="8.0">
                                                <children>
                                                    <Button fx:id="btnTrain" mnemonicParsing="false" onAction="#TrainModel" styleClass="ds-primary" text="Train" />
                                                    <Button fx:id="btnExportModel" mnemonicParsing="false" onAction="#exportModel" text="Export" />
                                                    <MenuButton mnemonicParsing="false" text="scikit-learn">
                                                        <items>
                                                            <MenuItem mnemonicParsing="false" onAction="#exportForSklearn" text="Export for scikit-learn" />
                                                            <MenuItem mnemonicParsing="false" onAction="#importFromSklearn" text="Import a model" />
                                                        </items>
                                                    </MenuButton>
                                                </children>
                                            </HBox>

                                            <Label styleClass="ds-section" text="Results" />
                                            <TextArea fx:id="taModelResults" editable="false" prefRowCount="12" wrapText="true" VBox.vgrow="ALWAYS" />
                                        </children>
                                    </VBox>
                                </content>
                            </ScrollPane>

                            <TabPane fx:id="modelTabs" tabClosingPolicy="UNAVAILABLE">
                                <tabs>
                                    <Tab text="Learning curve">
                                        <VBox>
                                            <padding>
                                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="ds-hint" text="Metric measured on the held-out test set after each batch of training rows." />
                                                <LineChart fx:id="TrainGraph" animated="false" createSymbols="true" title="Training progress" verticalGridLinesVisible="false" VBox.vgrow="ALWAYS">
                                                    <xAxis>
                                                        <NumberAxis label="Batch" side="BOTTOM" />
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis label="Score" side="LEFT" />
                                                    </yAxis>
                                                </LineChart>
                                            </children>
                                        </VBox>
                                    </Tab>

                                    <Tab text="Predicted vs actual">
                                        <VBox>
                                            <padding>
                                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="ds-hint" text="Points on the diagonal are perfect predictions." />
                                                <ScatterChart fx:id="graphModelEvaluation" animated="false" title="Test set" verticalGridLinesVisible="false" VBox.vgrow="ALWAYS">
                                                    <xAxis>
                                                        <NumberAxis label="Actual" side="BOTTOM" />
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis label="Predicted" side="LEFT" />
                                                    </yAxis>
                                                </ScatterChart>
                                            </children>
                                        </VBox>
                                    </Tab>

                                    <Tab text="Residuals">
                                        <VBox>
                                            <padding>
                                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="ds-hint" text="A shapeless cloud around zero means the model captured the structure." />
                                                <ScatterChart fx:id="graphModelResidual" animated="false" title="Residuals" verticalGridLinesVisible="false" VBox.vgrow="ALWAYS">
                                                    <xAxis>
                                                        <NumberAxis label="Predicted" side="BOTTOM" />
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis label="Residual" side="LEFT" />
                                                    </yAxis>
                                                </ScatterChart>
                                            </children>
                                        </VBox>
                                    </Tab>

                                    <Tab text="Feature weight">
                                        <VBox>
                                            <padding>
                                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="ds-hint" text="Importance for tree models, coefficients for linear ones." />
                                                <BarChart fx:id="chartImportance" animated="false" legendVisible="false" title="Feature weight" VBox.vgrow="ALWAYS">
                                                    <xAxis>
                                                        <CategoryAxis side="BOTTOM" />
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis side="LEFT" />
                                                    </yAxis>
                                                </BarChart>
                                            </children>
                                        </VBox>
                                    </Tab>

                                    <Tab text="Predict">
                                        <VBox spacing="8.0">
                                            <padding>
                                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="ds-hint" text="Type one value per feature and run the trained model on it." />
                                                <ScrollPane fitToWidth="true" prefHeight="180.0">
                                                    <content>
                                                        <GridPane fx:id="TestBox" hgap="8.0" vgap="6.0">
                                                            <padding>
                                                                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                                                            </padding>
                                                        </GridPane>
                                                    </content>
                                                </ScrollPane>
                                                <Button mnemonicParsing="false" onAction="#PredictValue" styleClass="ds-primary" text="Predict" />
                                                <TextArea fx:id="textPredictHistory" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
                                            </children>
                                        </VBox>
                                    </Tab>
                                </tabs>
                            </TabPane>
                        </items>
                    </SplitPane>
                </Tab>

            </tabs>
        </TabPane>
    </center>

    <!-- ===== Ações rápidas ===== -->
    <right>
        <VBox prefWidth="220.0" spacing="10.0">
            <padding>
                <Insets bottom="12.0" left="6.0" right="12.0" top="12.0" />
            </padding>
            <children>
                <Label styleClass="ds-section" text="Quick actions" />
                <Button fx:id="btnQuickStats" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#computeQuickStats" text="Descriptive statistics" />
                <Button fx:id="btnDetectAnomalies" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#quickScanOutliers" text="Scan all columns" />
                <Button fx:id="btnMissingReport" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#quickMissingReport" text="Missing values report" />

                <Separator />

                <Label styleClass="ds-section" text="Export" />
                <HBox spacing="6.0">
                    <children>
                        <Button fx:id="btnExportCSV" mnemonicParsing="false" onAction="#handleExportCSV" text="CSV" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnExportJSON" mnemonicParsing="false" onAction="#handleExportJSON" text="JSON" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <Label styleClass="ds-hint" text="Exports the table rows, up to the row limit." wrapText="true" />

                <Separator />

                <Label styleClass="ds-section" text="History" />
                <ListView fx:id="lvHistory" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </right>

    <!-- ===== Rodapé ===== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="ds-statusbar">
            <padding>
                <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
            </padding>
            <children>
                <Label fx:id="lblFooter" styleClass="ds-hint" text="" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMemory" styleClass="ds-hint" text="Memory: --" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
