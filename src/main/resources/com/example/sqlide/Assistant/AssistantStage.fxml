<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="4.0" style="-fx-background-color: #2C2C2C; -fx-font-family: JetBrains Mono Medium;" stylesheets="@../../../../css/ContextMenuStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sqlide.Assistant.AssistantController">

    <children>

        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <padding>
                <Insets left="10.0" right="10.0" top="4.0" />
            </padding>
            <children>
                <Hyperlink fx:id="BackButton" onAction="#back" style="-fx-font-size: 14px;" stylesheets="@../../../../css/Hyper.css" text="&lt;- Back" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="ModelLabel" style="-fx-text-fill: #9A9A9A; -fx-font-size: 11px;" />
                <Button mnemonicParsing="false" onAction="#openModelSettings" style="-fx-background-color: transparent; -fx-text-fill: #C0C0C0; -fx-border-color: #4A4A4A; -fx-border-radius: 4px;" text="Settings">
                    <tooltip>
                        <Tooltip text="Provider, model and API key" />
                    </tooltip>
                </Button>
            </children>
        </HBox>

        <ScrollPane fx:id="MessagesScroll" fitToWidth="true" VBox.vgrow="ALWAYS">
            <stylesheets>
                <URL value="@../../../../css/ScrollHbarStyle.css" />
                <URL value="@../../../../css/TextAreaStyle.css" />
            </stylesheets>
            <content>
                <VBox fx:id="MessagesBox" fillWidth="true" spacing="10.0" style="-fx-background-color: #262626;">
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="8.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <VBox spacing="6.0" style="-fx-background-color: #3A3A3A; -fx-background-radius: 15px; -fx-border-radius: 15px;">
            <padding>
                <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
            </padding>
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </VBox.margin>
            <children>

                <FlowPane fx:id="AttachmentsBox" hgap="6.0" managed="false" vgap="6.0" visible="false" />

                <TextArea fx:id="MessageBox" prefRowCount="3" promptText="Talk to Assistant" style="-fx-background-color: #3A3A3A; -fx-control-inner-background: #3A3A3A;" wrapText="true">
                    <stylesheets>
                        <URL value="@../../../../css/TextAreaStyle.css" />
                        <URL value="@../../../../css/ScrollHbarStyle.css" />
                    </stylesheets>
                    <font>
                        <Font name="JetBrains Mono Medium" size="12.0" />
                    </font>
                </TextArea>

                <HBox alignment="CENTER_LEFT" spacing="6.0" stylesheets="@../../../../css/Assistant/AssistantToolButtonStyle.css">
                    <children>
                        <Button fx:id="FuncButton" mnemonicParsing="false" onAction="#HandleFunc" text="Tools">
                            <tooltip>
                                <Tooltip text="Let the assistant read and change the database" />
                            </tooltip>
                        </Button>
                        <Button fx:id="SearchButton" mnemonicParsing="false" onAction="#HandleSearch" text="Search">
                            <tooltip>
                                <Tooltip text="Let the assistant search the web" />
                            </tooltip>
                        </Button>
                        <Button fx:id="DeepButton" mnemonicParsing="false" onAction="#HandleDeep" text="Think">
                            <tooltip>
                                <Tooltip text="Extended reasoning before answering" />
                            </tooltip>
                        </Button>

                        <Region HBox.hgrow="ALWAYS" />

                        <JFXButton fx:id="AttachButton" mnemonicParsing="false" onAction="#attachFiles" style="-fx-background-color: #4A4A4A; -fx-border-radius: 30px;" textFill="WHITE">
                            <graphic>
                                <FontAwesomeIconView fill="#e8e1e1" glyphName="PAPERCLIP" size="15.0" />
                            </graphic>
                            <tooltip>
                                <Tooltip text="Attach files to the message" />
                            </tooltip>
                        </JFXButton>
                        <JFXButton fx:id="MicrophoneButton" mnemonicParsing="false" onAction="#record" style="-fx-background-color: #3574F0; -fx-border-radius: 30px;" textFill="WHITE">
                            <graphic>
                                <FontAwesomeIconView fill="#ffffff" glyphName="MICROPHONE" size="15.0" />
                            </graphic>
                            <tooltip>
                                <Tooltip text="Dictate a message" />
                            </tooltip>
                        </JFXButton>
                        <JFXButton fx:id="SendButton" mnemonicParsing="false" onAction="#SendMessage" style="-fx-background-color: #3574F0; -fx-border-radius: 30px;" textFill="WHITE">
                            <graphic>
                                <FontAwesomeIconView fill="#ffffff" glyphName="ARROW_CIRCLE_RIGHT" size="17.0" />
                            </graphic>
                            <tooltip>
                                <Tooltip text="Send" />
                            </tooltip>
                        </JFXButton>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>

</VBox>
